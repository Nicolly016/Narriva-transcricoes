# Public project coordinates. They identify the Supabase project and are readable by the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Accepted only when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional queue. Without it, the server still transcribes after upload.
REDIS_URL=
